files:
  "/etc/logrotate.d/tomcat-catalina":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/tomcat/catalina.out {
        daily
        rotate 7
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
        size 100M
      }
